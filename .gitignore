__pycache__/
*.pyc
# Прогоны модели точек: веса (fold*.pt, 187 МБ; *_last.pt — ещё 780 МБ) в git
# не кладутся. Мелкие файлы прогона — нужны: конфиг и пороги видимости
# читаются при инференсе, метрики и история обучения — отчётность (ТЗ 8.4),
# oof.npz — OOF-предсказания, из которых метрики пересчитываются.
runs/**
!runs/keypoints/
!runs/keypoints/config.yaml
!runs/keypoints/thresholds.csv
!runs/keypoints/metrics_*.csv
!runs/keypoints/fold*_history.csv
!runs/keypoints/oof.npz
!runs/keypoints/oof_points.csv
# Метрики сравнения «точки против контура» (python -m service.evaluate
# --keypoints-oof / --keypoints --out runs/eval_*/metrics.json) — на них
# опирается таблица в README.
!runs/eval_oof/
!runs/eval_oof/metrics.json
!runs/eval_ens/
!runs/eval_ens/metrics.json
# Базовая линия «только геометрия» (python -m service.evaluate --no-cnn) и её
# скорость — с ними сравнивается сервис с нейросетью в README и презентации.
!runs/eval_geometry/
!runs/eval_geometry/metrics.json
!runs/benchmark_geometry.json
# Исходное решение до доработок под эксперта: без сети, ROI по рисунку 6 ТЗ
!runs/eval_baseline/
!runs/eval_baseline/metrics.json

# Презентация: PNG слайдов — промежуточный рендер (HTML-скриншоты и экспорт
# PowerPoint для миниатюр в докладе .docx)
docs/presentation/assets/slides/
docs/presentation/assets/pptx_png/

# Демо-архив (python docs/presentation/make_demo_zip.py)
/demo.zip
# Вариант HTML для публикации как Artifact (без обёртки html/head) — генерируется
docs/presentation/slides.artifact.html
