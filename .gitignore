__pycache__/
*.pyc
.DS_Store
/.venv-local/
/:memory:.ses
# Нейросетевые чекпоинты хранятся отдельно от Git (в том числе вне runs/).
*.pt
*.pth
*.ckpt
*.safetensors
# Прогоны модели точек: веса и построчные предсказания остаются локально.
# Публикуются конфигурация, агрегированные метрики и история обучения.
runs/**
!runs/keypoints/
!runs/keypoints/config.yaml
!runs/keypoints/thresholds.csv
!runs/keypoints/metrics_*.csv
!runs/keypoints/fold*_history.csv
# Прогон с подтверждёнными врачебными кропами: только общие показатели.
!runs/keypoints_crops/
!runs/keypoints_crops/config.yaml
!runs/keypoints_crops/thresholds.csv
!runs/keypoints_crops/thresholds_anchor.csv
!runs/keypoints_crops/thresholds_crop.csv
!runs/keypoints_crops/metrics_*.csv
!runs/keypoints_crops/metrics_*.json
!runs/keypoints_crops/fold*_history.csv
# Метрики сравнения «точки против контура» на кадрах обученных фолдов 0–1
# (python -m service.evaluate --folds 0 1 --no-cnn --roi-rule margins
# [--keypoints-oof] --out runs/eval_oof[_contour]/metrics.json) — на них
# опирается таблица в README.
!runs/eval_oof/
!runs/eval_oof/metrics.json
!runs/eval_oof_contour/
!runs/eval_oof_contour/metrics.json
# Базовая линия «только геометрия» (python -m service.evaluate --no-cnn) и её
# скорость — с ними сравнивается сервис с нейросетью в README и презентации.
!runs/eval_geometry/
!runs/eval_geometry/metrics.json
!runs/benchmark_geometry.json
# Исходное решение до доработок под эксперта: без сети, ROI по рисунку 6 ТЗ
!runs/eval_baseline/
!runs/eval_baseline/metrics.json


# Демо-архив (python docs/presentation/make_demo_zip.py)
/demo.zip

# Секреты: токен Telegram-бота и прочие локальные настройки (шаблон — .env.example)
.env
*.env
!.env.example
# Сборка настольного приложения и установщика (desktop/build_windows.ps1)
/build/
/dist/

# Файлы блокировки LibreOffice/Office
.~lock.*#
~$*

# Медицинские изображения не публикуются (ТЗ 3.2): обучающий набор и всё, в чём
# есть снимки DXA, хранится только локально и передаётся организаторам отдельно.
*.dcm
/НД_для_обучения/
/data/*.npz
# Клиническая разметка, координаты и отчёты по отдельным исследованиям
# хранятся только локально, даже если пикселей в файле нет.
/Processing/
/data/
/folds.csv
/cnn_qc/*/oof.csv
/hip_roi/eval/margins_*.csv
/hip_rotation/measurements.csv
/region_clf/labels.csv
/service/evaluation.csv
/spine_qc/measurements.csv
/runs/keypoints/oof.npz
/runs/keypoints/oof_points.csv
/runs/keypoints_crops/oof*.npz
/runs/keypoints_crops/oof_points.csv
/runs/keypoints_crops/fold0_paired_spine.csv
/runs/keypoints_crops/metrics_anchor_frames.csv
/runs/keypoints_crops/metrics_semantic_paired.csv
/notebooks/
/hip_roi/eval/*.png
/hip_roi/contradictions/
# Презентация, генераторы документов и снимки экрана — рабочие материалы команды.
# В репозитории остаются только версии документации без рентгеновских снимков:
# docs/Пояснительная_записка.pdf и docs/Инструкция_*.pdf.
/docs/presentation/
/docs/pitch/DXA_details.pptx
/docs/manuals/
/ЛЦТ2026 Шаблон презентации.pptx
/4. ДепЗдрав.pdf
