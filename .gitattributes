# Скрипты запуска исполняются в Linux: CRLF из Windows-чекаута ломает
# /bin/sh («$'\r': command not found»). Храним и выдаём их только с LF.
*.sh         text eol=lf
Dockerfile*  text eol=lf

# Веса сети cnn_qc: только двоичные, без преобразования концов строк
*.onnx       binary

# Установщик настольного приложения (288 МБ, больше лимита GitHub в 100 МБ) —
# через Git LFS. Обычный git clone его не скачивает (см. .lfsconfig).
release/*.exe filter=lfs diff=lfs merge=lfs -text
