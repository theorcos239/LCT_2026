# Настройки Telegram-бота и сервиса. Скопируйте в .env (он в .gitignore) и заполните.
# Реальный токен в репозиторий не кладётся никогда.

# Токен бота от @BotFather (обязательно для бота)
DXA_QC_TG_TOKEN=

# Кому разрешено пользоваться ботом: id или @username через запятую.
# Пусто — всем, кто найдёт бота.
DXA_QC_TG_ALLOWED=

# Отступы ROI: margins — по рисунку 6 ТЗ (по умолчанию);
# scan_length — прежнее правило длины поля.
DXA_QC_ROI_RULE=margins

# 0 — без нейросетевого второго мнения (только геометрия)
DXA_QC_CNN=1

# Демо-архив для команды /demo (по умолчанию demo.zip в корне репозитория)
# DXA_QC_DEMO=/путь/к/demo.zip
